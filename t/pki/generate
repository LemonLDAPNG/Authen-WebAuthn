#!/bin/bash
#
# Regenerates the test PKI in this directory: a root and an intermediate
# authority, and attestation certificates signed by them, some valid and
# some each breaking one rule of WebAuthn's packed attestation (section
# 8.2.1). Keys are for tests only. Certificates are valid for 100 years.
#
# Run from anywhere: t/pki/generate
#
# With certificate names, only those are made again, with the existing
# authorities: t/pki/generate tpm-aik tpm-ca

set -euo pipefail
cd "$(dirname "$0")"
only=" $* "
[ "$#" -eq 0 ] && rm -f -- *.pem *.srl

days=36500
serial=1
subject="/C=US/O=Authen-WebAuthn Tests/OU=Authenticator Attestation"

key() {
    case "$2" in
        p256)    openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 ;;
        p384)    openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-384 ;;
        rsa)     openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 ;;
        ed25519) openssl genpkey -algorithm ED25519 ;;
    esac >"$1-key.pem" 2>/dev/null
}

# name, key type, subject, issuer, extensions (empty for a version 1 cert)
cert() {
    local name=$1 type=$2 subj=$3 issuer=$4 ext=$5
    [ "$only" != "  " ] && [[ "$only" != *" $name "* ]] && return
    key "$name" "$type"
    openssl req -new -key "$name-key.pem" -subj "$subj" -out "$name.csr"
    openssl x509 -req -in "$name.csr" -CA "$issuer.pem" \
        -CAkey "$issuer-key.pem" -set_serial $((serial++)) -days $days \
        ${ext:+-extfile <(printf '%s\n' "$ext")} -out "$name.pem" 2>/dev/null
    rm "$name.csr"
}

leaf="basicConstraints=critical,CA:FALSE"
ca="basicConstraints=critical,CA:TRUE
keyUsage=critical,keyCertSign,cRLSign"

if [ "$#" -eq 0 ]; then
    key root p256
    openssl req -x509 -new -key root-key.pem -days $days \
        -subj "/C=US/O=Authen-WebAuthn Tests/CN=Test Root" \
        -addext "basicConstraints=critical,CA:TRUE" \
        -addext "keyUsage=critical,keyCertSign,cRLSign" -out root.pem
fi
cert intermediate p256 "/C=US/O=Authen-WebAuthn Tests/CN=Test Intermediate" \
    root "$ca"

cert packed-p256    p256    "$subject/CN=Packed P-256"    root "$leaf"
cert packed-p384    p384    "$subject/CN=Packed P-384"    root "$leaf"
cert packed-rsa     rsa     "$subject/CN=Packed RSA"      root "$leaf"
cert packed-ed25519 ed25519 "$subject/CN=Packed Ed25519"  root "$leaf"
cert packed-chained p256    "$subject/CN=Packed Chained"  intermediate "$leaf"

# id-fido-gen-ce-aaguid for 01020304-0506-0708-090a-0b0c0d0e0f10
cert packed-aaguid p256 "$subject/CN=Packed AAGUID" root "$leaf
1.3.6.1.4.1.45724.1.1.4=DER:04:10:01:02:03:04:05:06:07:08:09:0a:0b:0c:0d:0e:0f:10"
cert packed-aaguid-critical p256 "$subject/CN=Packed AAGUID critical" root "$leaf
1.3.6.1.4.1.45724.1.1.4=critical,DER:04:10:01:02:03:04:05:06:07:08:09:0a:0b:0c:0d:0e:0f:10"

cert bad-ou    p256 "/C=US/O=Authen-WebAuthn Tests/OU=Other/CN=Bad OU" root "$leaf"
cert bad-no-c  p256 "/O=Authen-WebAuthn Tests/OU=Authenticator Attestation/CN=Bad no C" root "$leaf"
cert bad-no-o  p256 "/C=US/OU=Authenticator Attestation/CN=Bad no O" root "$leaf"
cert bad-no-cn p256 "/C=US/O=Authen-WebAuthn Tests/OU=Authenticator Attestation" root "$leaf"
cert bad-no-ou p256 "/C=US/O=Authen-WebAuthn Tests/CN=Bad no OU" root "$leaf"
cert bad-ca    p256 "$subject/CN=Bad CA" root "basicConstraints=critical,CA:TRUE"
cert bad-no-bc p256 "$subject/CN=Bad no Basic Constraints" root "subjectKeyIdentifier=hash"
cert bad-v1    p256 "$subject/CN=Bad version 1" root ""

# TPM attestation (AIK) certificates: an empty subject, the TPM named in the
# Subject Alternative Name (TCG EK Credential Profile 3.2.9) and the
# tcg-kp-AIKCertificate key usage. OpenSSL takes a leading "N." in a field
# name as a prefix, so the OIDs below are written 1.2.23.133...
tpm_san="subjectAltName=critical,dirName:tpm_dn
[tpm_dn]
1.2.23.133.2.1=id:00000000
1.2.23.133.2.2=Test TPM
1.2.23.133.2.3=id:00000000"
tpm_eku="extendedKeyUsage=2.23.133.8.3"

cert tpm-aik     p256 "/" root "$leaf
$tpm_eku
$tpm_san"
cert tpm-no-san  p256 "/" root "$leaf
$tpm_eku"
cert tpm-san-other p256 "/" root "$leaf
$tpm_eku
subjectAltName=critical,dirName:other_dn
[other_dn]
CN=Not a TPM"
cert tpm-no-eku  p256 "/" root "$leaf
$tpm_san"
cert tpm-eku-other p256 "/" root "$leaf
extendedKeyUsage=serverAuth
$tpm_san"
cert tpm-ca      p256 "/" root "basicConstraints=critical,CA:TRUE
$tpm_eku
$tpm_san"
cert tpm-no-bc   p256 "/" root "$tpm_eku
$tpm_san"

# A FIDO Metadata Service: a root, a CA publishing CRLs, two BLOB signers
# and a signer the CA has revoked. t/mds.pl signs BLOBs with them.
#   t/pki/generate mds
if [ "$#" -eq 0 ] || [[ "$only" == *" mds "* ]]; then
    rm -f -- mds-*.pem mds-*.crl
    key mds-root p256
    openssl req -x509 -new -key mds-root-key.pem -days $days \
        -subj "/C=US/O=Authen-WebAuthn Tests/CN=Test Metadata Root" \
        -addext "basicConstraints=critical,CA:TRUE" \
        -addext "keyUsage=critical,keyCertSign,cRLSign" -out mds-root.pem
    cdp="crlDistributionPoints=URI:http://mds.test/crl"
    only=" mds-ca mds-signer mds-signer-rsa mds-revoked "
    cert mds-ca p256 "/C=US/O=Authen-WebAuthn Tests/CN=Test Metadata CA" \
        mds-root "$ca
$cdp/root.crl"
    for signer in mds-signer:p256 mds-signer-rsa:rsa mds-revoked:p256; do
        cert "${signer%:*}" "${signer#*:}" \
            "/C=US/O=Authen-WebAuthn Tests/CN=Test Metadata ${signer%:*}" \
            mds-ca "$leaf
$cdp/ca.crl"
    done

    # openssl ca keeps its state in files
    db=$(mktemp -d)
    crl() {
        local issuer=$1 out=$2
        : >"$db/index.txt"
        printf '[ca]\ndefault_ca=x\n[x]\ndatabase=%s\ndefault_md=sha256\n' \
            "$db/index.txt" >"$db/conf"
        shift 2
        for revoked in "$@"; do
            openssl ca -config "$db/conf" -cert "$issuer.pem" \
                -keyfile "$issuer-key.pem" -revoke "$revoked.pem" 2>/dev/null
        done
        openssl ca -config "$db/conf" -gencrl -crldays $days \
            -cert "$issuer.pem" -keyfile "$issuer-key.pem" -out "$out" \
            2>/dev/null
    }
    crl mds-root mds-root.crl
    crl mds-ca mds-ca.crl mds-revoked
    rm -rf "$db"
fi

rm -f -- *.srl
